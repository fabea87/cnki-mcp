{
  "name": "cnki-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-maintained CNKI (知网) MCP server — pure-HTTP fast path + optional Playwright session warm-up",
  "bin": {
    "cnki-mcp": "dist/src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js",
    "probe": "node dist/scripts/probe-captcha.js",
    "warm": "node dist/scripts/warm-cli.js",
    "smoke": "node dist/scripts/smoke.js",
    "paging": "node dist/scripts/paging-test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "linkedom": "^0.18.5",
    "pngjs": "^7.0.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.7.2"
  }
}
